# rg_embed_file(FILE OUT SYMBOL): writes OUT, a C++ file defining
# `extern const unsigned char SYMBOL[]` and `extern const size_t SYMBOL_size`
# with FILE's bytes, at configure time, and configures again when FILE
# changes. For small read-only data the game carries inside its executable
# (the typeface of src/typeface_letters.cpp).
function(rg_embed_file file out symbol)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR bytes "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
    # A line every 16 bytes.
    set(sixteen "")
    foreach(i RANGE 15)
        string(APPEND sixteen "0x[0-9a-f][0-9a-f],")
    endforeach()
    string(REGEX REPLACE "(${sixteen})" "\\1\n" body "${body}")
    get_filename_component(name "${file}" NAME)
    file(WRITE "${out}.tmp"
        "// Generated by cmake/embed_file.cmake from ${name}: do not edit.\n"
        "#include <cstddef>\n"
        "extern const unsigned char ${symbol}[] = {\n${body}\n};\n"
        "extern const size_t ${symbol}_size = ${bytes};\n")
    file(COPY_FILE "${out}.tmp" "${out}" ONLY_IF_DIFFERENT)
    file(REMOVE "${out}.tmp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
endfunction()
