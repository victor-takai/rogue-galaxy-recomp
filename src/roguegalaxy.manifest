<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The game's code page is UTF-8 (Windows 10 version 1903 and later; older
     Windows ignores it). The runtime passes paths on as narrow text
     (std::filesystem's string(), fopen), which in the system's code page
     stopped the game at boot in a folder named in letters that code page
     lacks, such as Cyrillic or Japanese on code page 1252. In UTF-8 every
     letter fits, and the UTF-8 that SDL gives (the settings folder, from
     SDL_GetPrefPath) opens as it is. Only this, so nothing else about the
     process changes. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
