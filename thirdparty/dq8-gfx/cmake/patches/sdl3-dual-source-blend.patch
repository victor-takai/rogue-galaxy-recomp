+        desiredDeviceFeatures.dualSrcBlend = VK_TRUE;
+        renderer->supportsDualSourceBlend = true;
+    }
+
     // creating the logical device
 
     deviceCreateInfo.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO;
