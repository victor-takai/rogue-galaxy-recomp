@@ -1146,6 +1148,7 @@ struct VulkanRenderer
     bool supportsPhysicalDeviceProperties2;
     bool supportsFillModeNonSolid;
     bool supportsMultiDrawIndirect;
+    bool supportsDualSourceBlend; // dq8-gfx: added
 
     VulkanMemoryAllocator *memoryAllocator;
     VkPhysicalDeviceMemoryProperties memoryProperties;
@@ -6274,6 +6277,20 @@ static SDL_GPUGraphicsPipeline *VULKAN_CreateGraphicsPipeline(
     VkResult vulkanResult;
     Uint32 i;
 
+    // dq8-gfx: added. The second source's factors need the device's dualSrcBlend.
+    for (i = 0; i < createinfo->target_info.num_color_targets; i += 1) {
+        const SDL_GPUColorTargetBlendState *blend = &createinfo->target_info.color_target_descriptions[i].blend_state;
+        const bool second =
+            blend->src_color_blendfactor >= SDL_GPU_BLENDFACTOR_SRC1_ALPHA ||
+            blend->dst_color_blendfactor >= SDL_GPU_BLENDFACTOR_SRC1_ALPHA ||
+            blend->src_alpha_blendfactor >= SDL_GPU_BLENDFACTOR_SRC1_ALPHA ||
+            blend->dst_alpha_blendfactor >= SDL_GPU_BLENDFACTOR_SRC1_ALPHA;
+        if (blend->enable_blend && second && !((VulkanRenderer *)driverData)->supportsDualSourceBlend) {
+            SDL_SetError("Dual-source blending is not supported by this device");
+            return NULL;
+        }
+    }
+
     VulkanGraphicsPipeline *graphicsPipeline = (VulkanGraphicsPipeline *)SDL_malloc(sizeof(VulkanGraphicsPipeline));
     VkGraphicsPipelineCreateInfo vkPipelineCreateInfo;
 
