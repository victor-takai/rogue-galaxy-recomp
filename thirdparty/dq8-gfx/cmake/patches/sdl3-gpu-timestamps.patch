+    commandBuffer->dq8QueryCount = 0;
+    commandBuffer->dq8Labels = NULL;
+
     // Presentation tracking
 
     commandBuffer->presentDataCapacity = 1;
@@ -10367,6 +10518,13 @@ static void VULKAN_INTERNAL_CleanCommandBuffer(
