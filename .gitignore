# Game data: never commit anything read from the disc.
/disc/
*.iso
*.ISO
*.bin.part
*.part

# The game's 2D art collected from the screen and its larger versions
# (debug\RogueGalaxy-collect.bat): made from the disc, they stay local.
/textures/*/

# Memory cards the runtime keeps next to the disc: the player's saves.
/mc0/
/mc1/

# Build trees and logs
/build/
/out/
*.log
# The build tools Install.bat downloads.
/toolchain/
# The launcher the build puts in the repository's folder.
/Rogue Galaxy.exe
CMakeUserPresets.json

# Python
__pycache__/
*.pyc

# Editors / OS
.vs/
.vscode/
.idea/
.cache/
Thumbs.db
.DS_Store

# Art collected from the disc while playing (the texture-pack branch).
/textures/

# The player's own images for the window's sides; only the note is kept.
/borders/*
!/borders/README.txt
