+// RG_EE_WAITLOG=1 (Rogue Galaxy: added): where the executor's host time goes,
+// every second: inside each guest thread, idle (waitForEvent), and the rest
+// (the scheduler itself); and what each guest thread waited on, by reason and
+// object, for how long. A frame's cost when unpaced is the executor's time
+// between vsyncs, so this names what it is spent on.
+namespace eewait
+{
+using Clock = std::chrono::steady_clock;
+const bool g_on = [] {
+    const char *v = std::getenv("RG_EE_WAITLOG");
+    return v && *v && *v != '0';
+}();
+struct Key
+{
+    int thread;
+    int reason;
+    int object;
+    bool operator==(const Key &o) const { return thread == o.thread && reason == o.reason && object == o.object; }
+};
+struct KeyHash
+{
+    size_t operator()(const Key &k) const { return (size_t(k.thread) * 131u + size_t(k.reason)) * 65599u + size_t(k.object); }
+};
+struct Span
+{
+    uint64_t ns = 0, count = 0;
+};
+std::mutex g_mutex;
+std::unordered_map<int, Span> g_running;  // host ns inside each guest thread
+std::unordered_map<int, Clock::time_point> g_blockedAt;
+std::unordered_map<int, Key> g_blockedOn;
+std::unordered_map<Key, Span, KeyHash> g_waits;
+Span g_idle, g_sched;
+uint64_t g_vsyncs = 0;
+Clock::time_point g_windowStart = Clock::now();
+
+int objectOf(const EeWaitState &w)
+{
+    if (const auto *sema = std::get_if<EeSemaphoreWait>(&w.payload))
+        return sema->id;
+    if (const auto *flag = std::get_if<EeEventFlagWait>(&w.payload))
+        return flag->id;
+    if (const auto *ext = std::get_if<EeExternalWait>(&w.payload))
+        return int(ext->type);
+    return 0;
+}
+void blocked(int thread, const EeWaitState &w)
+{
+    if (!g_on)
+        return;
+    std::lock_guard lock(g_mutex);
+    g_blockedAt[thread] = Clock::now();
+    g_blockedOn[thread] = Key{thread, int(w.reason), objectOf(w)};
+}
+void woken(int thread)
+{
+    if (!g_on)
+        return;
+    std::lock_guard lock(g_mutex);
+    const auto at = g_blockedAt.find(thread);
+    if (at == g_blockedAt.end())
+        return;
+    Span &span = g_waits[g_blockedOn[thread]];
+    span.ns += uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - at->second).count());
+    ++span.count;
+    g_blockedAt.erase(at);
+}
+const char *reasonName(int r)
+{
+    static const char *names[] = {"none", "sleep", "sema", "eventflag", "vsync", "external", "mpeg"};
+    return r >= 0 && r < 7 ? names[r] : "?";
+}
