+void EeScheduler::reportWaitLog()
+{
+    using namespace eewait;
+    const auto now = Clock::now();
+    const uint64_t window = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(now - g_windowStart).count());
+    if (window < 1000000000ull)
+        return;
+    std::lock_guard lock(g_mutex);
+    const double w = double(window);
+    uint64_t guest = 0;
+    std::vector<std::pair<uint64_t, int>> threads;
+    for (const auto &[id, span] : g_running)
+    {
+        guest += span.ns;
+        threads.emplace_back(span.ns, id);
+    }
+    std::sort(threads.rbegin(), threads.rend());
+    const uint64_t sched = window > guest + g_idle.ns ? window - guest - g_idle.ns : 0;
+    std::fprintf(stderr, "[eewait] %.2fs vsyncs %llu (%.1f ms each) | guest %.0f%% idle %.0f%% (%llu sleeps) sched %.0f%% |",
+                 w / 1e9, (unsigned long long)g_vsyncs, g_vsyncs ? w / 1e6 / double(g_vsyncs) : 0.0,
+                 100.0 * double(guest) / w, 100.0 * double(g_idle.ns) / w, (unsigned long long)g_idle.count,
+                 100.0 * double(sched) / w);
+    for (size_t i = 0; i < threads.size() && i < 8; ++i)
+    {
+        const GuestThread *t = thread(threads[i].second);
+        std::fprintf(stderr, " t%d(%06x p%d) %.1f%%", threads[i].second, t ? t->entry : 0u,
+                     t ? t->currentPriority : -1, 100.0 * double(threads[i].first) / w);
+    }
+    std::fprintf(stderr, "\n");
+    std::vector<std::pair<uint64_t, Key>> waits;
+    for (const auto &[key, span] : g_waits)
+        waits.emplace_back(span.ns, key);
+    std::sort(waits.begin(), waits.end(), [](const auto &l, const auto &r) { return l.first > r.first; });
+    std::fprintf(stderr, "[eewait]   waits:");
+    for (size_t i = 0; i < waits.size() && i < 10; ++i)
+    {
+        const Key &k = waits[i].second;
+        const Span &span = g_waits[k];
+        std::fprintf(stderr, " t%d %s %d %.1f%% x%llu (%.2f ms);", k.thread, reasonName(k.reason), k.object,
+                     100.0 * double(span.ns) / w, (unsigned long long)span.count,
+                     span.count ? double(span.ns) / 1e6 / double(span.count) : 0.0);
+    }
+    std::fprintf(stderr, "\n");
+    g_running.clear();
+    g_waits.clear();
+    g_idle = {};
+    g_vsyncs = 0;
+    g_windowStart = now;
+}
