+bool PS2Runtime::directGuestCall(uint8_t *rdram,
+                                 R5900Context *ctx,
+                                 RecompiledFunction fn,
+                                 uint32_t targetPc,
+                                 uint32_t sourcePc,
+                                 uint32_t fallthroughPc)
+{
+    if (!fn)
+    {
+        // Missing: the dispatcher reports it and applies the policy.
+        return dispatchGuestBranch(rdram, ctx, targetPc, sourcePc, fallthroughPc,
+                                   GuestBranchKind::DirectCall, "JAL");
+    }
+
+    // The rest is dispatchGuestBranch's call path; see the reasons there.
+    ctx->pc = targetPc;
+    if (m_eeScheduler && m_eeScheduler->checkpointDue(EeScheduler::kGuestDispatchCycles))
+    {
+        m_eeScheduler->noteGuestUnwind();
+        return false;
+    }
+
+    pushDispatchPc(targetPc);
+    const uint32_t entrySp = static_cast<uint32_t>(_mm_extract_epi32(ctx->r[29], 0));
+    const uint64_t unwindSerial = m_eeScheduler ? m_eeScheduler->guestUnwindSerial() : 0u;
+    fn(rdram, ctx, this);
+
+    if (isStopRequested() || ctx->pc == 0u)
+    {
+        return false;
+    }
+
+    if (ctx->pc == targetPc && static_cast<uint32_t>(_mm_extract_epi32(ctx->r[29], 0)) == entrySp &&
+        !(m_eeScheduler && m_eeScheduler->guestUnwoundSince(unwindSerial)))
+    {
+        ctx->pc = fallthroughPc;
+    }
+
+    return ctx->pc == fallthroughPc;
+}
