 // game names a VU1 program here, src/vif1_thread.cpp); the threaded backend
 // stamps each batch with it. Profiling only; 0 is "none" (Rogue Galaxy: added).
 inline thread_local uint32_t t_sourceTag = 0;
+
+// The camera a VU1 program ran under: the matrices the game keeps in VU1
+// data memory (quads 4-7 the viewport transform, 8-11 the projection, 24-27
+// the view), as row-vector 4x4 floats. The submitting thread registers one
+// and names it by id; batches carry the id and the renderer looks it up,
+// for motion vectors (Rogue Galaxy: added).
+struct SceneCamera
+{
+    float viewport[16];
+    float projection[16];
+    float view[16];
+};
+inline thread_local uint32_t t_sourceCamera = 0;
+
+class CameraRegistry
+{
+public:
+    static constexpr uint32_t kSlots = 4096u;
+
+    // The id of `camera`, 0 is none. The same camera as the last registered
+    // keeps its id. The newest kSlots stay readable.
+    static uint32_t add(const SceneCamera &camera)
+    {
+        Storage &s = storage();
+        std::lock_guard lock(s.mutex);
+        if (s.last != 0u && std::memcmp(&s.slots[s.last % kSlots], &camera, sizeof(camera)) == 0)
+        {
+            return s.last;
+        }
+        s.slots[++s.last % kSlots] = camera;
+        return s.last;
+    }
+
+    static bool get(uint32_t id, SceneCamera &out)
+    {
+        Storage &s = storage();
+        std::lock_guard lock(s.mutex);
+        if (id == 0u || id > s.last || s.last - id >= kSlots)
+        {
+            return false;
+        }
+        out = s.slots[id % kSlots];
+        return true;
+    }
+
+private:
+    struct Storage
+    {
+        std::mutex mutex;
+        SceneCamera slots[kSlots];
+        uint32_t last = 0u;
+    };
+    static Storage &storage()
+    {
+        static Storage instance;
+        return instance;
+    }
+};
 } // namespace ps2_gs_detail
 
