+namespace
+{
+thread_local GS::RegisterSink *t_registerSink = nullptr;
+}
+
+void GS::setRegisterSink(RegisterSink *sink)
+{
+    t_registerSink = sink;
+}
+
 void GS::writeRegister(uint8_t regAddr, uint64_t value)
 {
+    if (t_registerSink)
+    {
+        t_registerSink->emplace_back(regAddr, value);
+        return;
+    }
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
     writeRegisterUnlocked(regAddr, value);
 }
