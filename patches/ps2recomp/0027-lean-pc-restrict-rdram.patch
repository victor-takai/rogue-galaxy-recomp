+    bool CodeGenerator::pcUnobserved(const Instruction &inst)
+    {
+        // Rogue Galaxy: added (lean_pc). Anything that touches memory, the
+        // VU, COP0, or control flow keeps its PC store.
+        if (inst.isLoad || inst.isStore || inst.isBranch || inst.isJump || inst.isCall || inst.isReturn ||
+            inst.isVU || inst.isMmio || inst.hasDelaySlot)
+            return false;
+        switch (inst.opcode)
+        {
+        case 0x00: // SPECIAL: not SYSCALL, BREAK, SYNC, the traps, JR, JALR, nor the
+                   // overflow-trapping ADD, SUB, DADD, DSUB
+        {
+            const uint32_t f = inst.function;
+            return !(f == 0x08u || f == 0x09u || f == 0x0Cu || f == 0x0Du || f == 0x0Fu || (f >= 0x30u && f <= 0x36u) ||
+                     f == 0x20u || f == 0x22u || f == 0x2Cu || f == 0x2Eu);
+        }
+        case 0x09: case 0x0A: case 0x0B: case 0x0C: case 0x0D: case 0x0E: case 0x0F: // ADDIU..LUI (not ADDI)
+        case 0x19:                                                                   // DADDIU (not DADDI)
+        case 0x11:                                                                              // COP1 (FPU)
+        case 0x1C:                                                                              // MMI
+            return true;
+        default:
+            return false;
+        }
+    }
+
     CodeGenerator::~CodeGenerator() = default;
 
