 endif()
 
+# The compiled VU code (the routines' and the blocks' shards) is a target of
+# its own, part of ps2_runtime and built with ps2_runtime's include folders,
+# definitions and options, so that only it goes through the VU pool: with
+# the pool on all of ps2_runtime, the runtime's other units, ready early,
+# waited behind the shards and were the last thing a first build compiled.
+# Linking nothing, its compiles wait for nothing but their generators, not
+# for what ps2_runtime links; so FFmpeg's downloaded headers are left out of
+# its include folders, and a shard that came to include one fails every
+# time instead of when the download is late. ps2_runtime's other target
+# properties do not follow (INTERPROCEDURAL_OPTIMIZATION: the game turns it
+# off on ps2_runtime after this file). The routines' shards come first:
+# Ninja starts jobs of equal priority in the order build.ninja lists them,
+# and after the block shards (the heaviest first) they were the end of a
+# build, about 16 s each.
+set(PS2X_VU_COMPILED_SOURCES ${PS2X_VU_PROGRAM_SOURCES} ${PS2X_VU_AOT_SOURCES})
+if(PS2X_VU_COMPILED_SOURCES)
+    add_library(ps2_vu_compiled OBJECT ${PS2X_VU_COMPILED_SOURCES})
+    set_property(TARGET ps2_vu_compiled PROPERTY INCLUDE_DIRECTORIES
+        "$<FILTER:$<TARGET_PROPERTY:ps2_runtime,INCLUDE_DIRECTORIES>,EXCLUDE,/ThirdParty/ffmpeg-prefix/>")
+    foreach(PS2X_FLAGS IN ITEMS COMPILE_DEFINITIONS COMPILE_OPTIONS)
+        set_property(TARGET ps2_vu_compiled PROPERTY ${PS2X_FLAGS} "$<TARGET_PROPERTY:ps2_runtime,${PS2X_FLAGS}>")
+    endforeach()
+    if(PS2X_VU_COMPILE_POOL)
+        set_property(TARGET ps2_vu_compiled PROPERTY JOB_POOL_COMPILE ${PS2X_VU_COMPILE_POOL})
+    endif()
+    # The generators' outputs are its sources: with a Makefile or Visual
+    # Studio generator each target using them gets its own copy of the
+    # rule, so it builds after the targets that run them.
+    foreach(PS2X_GENERATOR IN ITEMS ps2_vu_aot ps2_vu_programs)
+        if(TARGET ${PS2X_GENERATOR})
+            add_dependencies(ps2_vu_compiled ${PS2X_GENERATOR})
+        endif()
+    endforeach()
+    target_sources(ps2_runtime PRIVATE $<TARGET_OBJECTS:ps2_vu_compiled>)
+endif()
+
 if(PS2X_ENABLE_RUNTIME_LOGS)
     target_compile_definitions(ps2_runtime PUBLIC
         PS2_RUNTIME_LOGS=1
