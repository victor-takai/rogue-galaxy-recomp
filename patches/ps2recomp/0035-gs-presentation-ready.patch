+bool GSThreadedBackend::IsPresentationReady(const GSPresentationTicket &ticket) const
+{
+    const auto *prepared = dynamic_cast<const Impl::PresentationTicket *>(ticket.get());
+    if (!prepared || prepared->owner != m_impl->identity)
+        return true;
+    std::lock_guard lock(prepared->result->mutex);
+    return prepared->result->completed;
+}
