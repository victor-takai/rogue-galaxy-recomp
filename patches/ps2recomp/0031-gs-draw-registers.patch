+void GS::submitNativeMesh(const GSNativeMesh &mesh, const GSDrawState &state)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    m_vtxCount = 0;
+    m_vtxIndex = 0;
+    if (m_backend && mesh.vertices.size() >= 3u)
+        m_backend->SubmitNativeMesh(mesh, state);
+}
+
+GS::DrawRegisters GS::drawRegisters() const
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    DrawRegisters r;
+    r.ctx[0] = m_ctx[0];
+    r.ctx[1] = m_ctx[1];
+    r.primRegister = m_primRegister;
+    r.prmodeRegister = m_prmodeRegister;
+    r.prmodecont = m_prmodecont;
+    r.texa = m_texa;
+    r.texclut = m_texclut;
+    r.pabe = m_pabe;
+    r.scanmsk = m_scanmsk;
+    r.dimx = m_dimx;
+    r.dthe = m_dthe;
+    r.colclamp = m_colclamp;
+    r.fogR = m_fogR;
+    r.fogG = m_fogG;
+    r.fogB = m_fogB;
+    return r;
+}
