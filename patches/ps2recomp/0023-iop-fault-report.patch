+    std::string Iop::where(uint32_t address) const
+    {
+        const uint32_t physical = address & 0x1FFFFFFFu;
+        for (const Module &module : m_modules)
+        {
+            if (physical >= module.base && physical - module.base < module.size)
+            {
+                char offset[12];
+                std::snprintf(offset, sizeof(offset), "+0x%X", physical - module.base);
+                return hex(address) + " (" + module.name + offset + ")";
+            }
+        }
+        return hex(address) + (physical < kHeapBase ? " (kernel)" : " (no module)");
+    }
+
+    std::string Iop::stopDetail(StopReason reason, const CpuContext &c, uint64_t cycles) const
+    {
+        std::string text;
+        if (reason == StopReason::Fault)
+            text = "unsupported instruction " + hex(m_cpu.faultOp()) + " at " + where(m_cpu.faultPc());
+        else
+            text = "still running after " + std::to_string(cycles) + " cycles, at " + where(c.pc);
+        return text + ", ra " + where(c.gpr[31]) + ", sp " + hex(c.gpr[29]);
+    }
