+// A vertex as the program would have computed it.
+struct GSNativeMeshPoint
+{
+    float px = 0.0f, py = 0.0f, pz = 0.0f; // projected, before the fixed point
+    int32_t x16 = 0, y16 = 0, z16 = 0, f16 = 0; // FTOI4 of x, y, z and the fog
+    float pf = 0.0f;                       // the fog, before its fixed point
+    int32_t rgba[4] = {};                  // FTOI0 of the clamped color
