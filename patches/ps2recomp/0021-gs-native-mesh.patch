+// The Z of gsNativeMeshPoint alone (the same operations in the same order,
+// so the same bits): the whole units of the projected z, scaled and capped.
+inline float gsNativeMeshDepth(const GSNativeMesh::Header &h, const GSNativeMesh::Vertex &v)
+{
+    const auto &m = h.matrix;
+    const float z = v.x * m[0][2] + v.y * m[1][2] + v.z * m[2][2] + m[3][2];
+    const float w = v.x * m[0][3] + v.y * m[1][3] + v.z * m[2][3] + m[3][3];
+    const float pz = std::fmin(z * gsNativeReciprocal(w) * h.depthScale, h.depthMax);
+    return static_cast<float>((static_cast<uint32_t>(gsNativeFtoi(pz, 16.0f)) >> 4) & 0xFFFFFFu);
+}
+
+// Whether the triangle ending at vertex k (k >= 1) is skipped, with
+// `winding` its sign. The program also tests the second vertex, against a
+// "previous" vertex at the origin; it never draws, but its ADC is in the
+// packet.
+inline bool gsNativeMeshSkips(const GSNativeMesh::Header &h, const GSNativeMeshPoint *points, uint32_t k,
+                              float winding)
+{
+    const GSNativeMeshPoint origin{};
+    const GSNativeMeshPoint &a = k >= 2u ? points[k - 2u] : origin;
+    const GSNativeMeshPoint &b = points[k - 1u];
+    const GSNativeMeshPoint &c = points[k];
+    bool skip = h.guardBand && ((k >= 2u && a.outside) || b.outside || c.outside);
+    if (h.backface)
+    {
+        const float facing = ((c.px - b.px) * (b.py - a.py) - (b.px - a.px) * (c.py - b.py)) * winding;
+        skip = skip || facing < 0.0f;
+    }
+    return skip;
+}
+
+// A point as the GS front end makes a vertex of the program's packed ST,
+// RGBAQ and XYZF2.
+inline GSVertex gsNativeMeshVertex(const GSNativeMeshPoint &p)
+{
+    GSVertex out;
+    out.x = static_cast<float>(static_cast<uint16_t>(p.x16)) / 16.0f;
+    out.y = static_cast<float>(static_cast<uint16_t>(p.y16)) / 16.0f;
+    out.z = static_cast<float>((static_cast<uint32_t>(p.z16) >> 4) & 0xFFFFFFu);
+    out.r = static_cast<uint8_t>(p.rgba[0]);
+    out.g = static_cast<uint8_t>(p.rgba[1]);
+    out.b = static_cast<uint8_t>(p.rgba[2]);
+    out.a = static_cast<uint8_t>(p.rgba[3]);
+    out.q = p.q == 0.0f ? 1.0f : p.q;
+    out.s = p.s;
+    out.t = p.t;
+    out.fog = static_cast<uint8_t>((static_cast<uint32_t>(p.f16) >> 4) & 0xFFu);
+    return out;
+}
