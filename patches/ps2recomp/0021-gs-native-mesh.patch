+// The triangles the program would have kicked, as GS vertices.
+template <typename Emit>
+void gsExpandNativeMesh(const GSNativeMesh &mesh, Emit &&emit)
+{
+    const uint32_t count = static_cast<uint32_t>(mesh.vertices.size());
+    std::vector<GSNativeMeshPoint> points(count);
+    for (uint32_t k = 0; k < count; ++k)
+        points[k] = gsNativeMeshPoint(mesh.header, mesh.vertices[k]);
+    float winding = mesh.header.winding;
+    for (uint32_t k = 1; k < count; ++k)
+    {
+        const bool skip = gsNativeMeshSkips(mesh.header, points.data(), k, winding);
+        winding = -winding;
+        const bool kicks = mesh.header.triangleList ? k % 3u == 2u : k >= 2u;
+        if (kicks && !skip)
+        {
+            const GSVertex triangle[3] = {gsNativeMeshVertex(points[k - 2u]), gsNativeMeshVertex(points[k - 1u]),
+                                          gsNativeMeshVertex(points[k])};
+            emit(triangle);
+        }
+    }
+}
