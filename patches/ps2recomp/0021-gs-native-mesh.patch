+// 1 / x as the VU1's DIV gives it: at 0 the most float, with x's sign.
+inline float gsNativeReciprocal(float x)
+{
+    if (x != 0.0f)
+        return 1.0f / x;
+    return std::signbit(x) ? -std::numeric_limits<float>::max() : std::numeric_limits<float>::max();
+}
+
+// FTOI0 and FTOI4: truncation toward zero, saturated.
+inline int32_t gsNativeFtoi(float value, float scale)
+{
+    const double scaled = static_cast<double>(value) * scale;
+    if (!(scaled > -2147483648.0))
+        return std::numeric_limits<int32_t>::min();
+    if (scaled >= 2147483647.0)
+        return std::numeric_limits<int32_t>::max();
+    return static_cast<int32_t>(scaled);
+}
+
+inline GSNativeMeshPoint gsNativeMeshPoint(const GSNativeMesh::Header &h, const GSNativeMesh::Vertex &v)
+{
+    const auto &m = h.matrix;
+    float clip[4];
+    for (int i = 0; i < 4; ++i)
+        clip[i] = v.x * m[0][i] + v.y * m[1][i] + v.z * m[2][i] + m[3][i];
+    GSNativeMeshPoint p;
+    p.q = gsNativeReciprocal(clip[3]);
+    p.px = clip[0] * p.q;
+    p.py = clip[1] * p.q;
+    const float z = clip[2] * p.q;
+    p.pz = std::fmin(z * h.depthScale, h.depthMax);
+    const float f = std::fmax(std::fmin(h.fog[0] + h.fog[3] * clip[3], h.fog[1]), h.fog[2]);
+    p.pf = f;
+    p.x16 = gsNativeFtoi(p.px, 16.0f);
+    p.y16 = gsNativeFtoi(p.py, 16.0f);
+    p.z16 = gsNativeFtoi(p.pz, 16.0f);
+    p.f16 = gsNativeFtoi(f, 16.0f);
+    const float color[4] = {v.r, v.g, v.b, v.a};
+    for (int i = 0; i < 4; ++i)
+        p.rgba[i] = gsNativeFtoi(std::fmin(color[i], h.colorMax[i]), 1.0f);
+    p.s = v.u * p.q;
+    p.t = v.v * p.q;
+    const float projected[3] = {p.px, p.py, z};
+    for (int i = 0; i < 3; ++i)
+    {
+        const float g = projected[i] * h.bandScale[i] + h.bandOffset[i] * h.bandScale[i];
+        p.outside = p.outside || g > 1.0f || g < -1.0f;
+    }
+    return p;
+}
