+// A strip a VU1 program would have drawn, as the program's inputs (Rogue
+// Galaxy: added; the game's src/vu1_native.h builds it). A renderer that can
+// transforms the vertices itself (SdlGpuBackend, on the GPU); any other gets
+// the triangles the program would have kicked, from gsExpandNativeMesh. The
+// draw state is the GS's when it is submitted (GS::submitNativeMesh), as for
+// a primitive.
+struct GSNativeMesh
+{
+    struct Vertex
+    {
+        float x = 0.0f, y = 0.0f, z = 0.0f; // object space
+        float u = 0.0f, v = 0.0f;           // texture coordinates, before the divide by w
+        float r = 0.0f, g = 0.0f, b = 0.0f, a = 0.0f; // color before the clamp, 0-255
+        // The Z the program computes (gsNativeMeshDepth, in the VU's rounding),
+        // when not negative: a renderer whose arithmetic rounds otherwise
+        // takes it as it is, since a pass drawn at nearly the same depth
+        // turns a unit of difference into missing pixels.
+        float depth = -1.0f;
+    };
+    // Trivially copyable: the game's GIF stage carries it as bytes.
+    struct Header
+    {
+        // To GS window coordinates (XYOFFSET included), row vectors:
+        // clip = x * matrix[0] + y * matrix[1] + z * matrix[2] + matrix[3].
+        float matrix[4][4] = {};
+        // F = clamp(fog[0] + fog[3] * w, at most fog[1], at least fog[2]).
+        float fog[4] = {};
+        // The projected z, scaled, then capped, before its fixed point.
+        float depthScale = 1.0f;
+        float depthMax = std::numeric_limits<float>::max();
+        float colorMax[4] = {};
+        // A vertex is outside the guard band when p * bandScale + bandOffset *
+        // bandScale passes 1 in x, y or z, p the projected point (its z
+        // before depthScale), as the program sums it.
+        float bandScale[4] = {};
+        float bandOffset[4] = {};
+        // The first triangle's winding sign; it flips from one to the next.
+        float winding = 1.0f;
